# ==== Core ====
ENV=development            # development | production
SECRET_KEY=change-me-to-a-long-random-string   # openssl rand -hex 64
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ==== Postgres ====
POSTGRES_USER=boardgame
POSTGRES_PASSWORD=boardgame-dev-password
POSTGRES_DB=boardgame
DATABASE_URL=postgresql+asyncpg://boardgame:boardgame-dev-password@db:5432/boardgame

# ==== Redis ====
REDIS_URL=redis://redis:6379/0

# ==== Auth ====
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==== Nginx (host port) ====
HTTP_PORT=80

# ==== Admin ====
ADMIN_EMAIL=you@example.com

# ==== Voice (LiveKit) ====
LIVEKIT_API_SECRET=devsecret-please-change-me-32-chars-min!!
# Browser-reachable LiveKit URL (use wss://voice.yourdomain.com in production)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
